# PostgreSQL (Neon connection string, e.g. postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=
# Separate DB used ONLY by integration tests
TEST_DATABASE_URL=

# Firebase Admin (server-side token verification) - from a service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase web app config (public values, used by the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
